{
  "StructureBuilder": {
    "DefaultHeadingLevel": 1,
    "MaximumHeadingLevel": 6,
    "CreateRootSection": true,
    "RootSectionTitle": "متن اصلی سند"
  },
  "HeadingDetection": {
    "MinimumConfidence": 0.60,
    "MaximumHeadingLength": 180,
    "UseStyleInformation": true,
    "UseNumberingPatterns": true,
    "UsePersianPatterns": true,
    "UseArabicPatterns": true,
    "UseEnglishPatterns": true,
    "UseTextPatterns": true,
    "CustomPatterns": []
  },
  "ContentBlockClassifier": {
    "DetectOrderedLists": true,
    "DetectUnorderedLists": true,
    "DetectQuotes": true,
    "DetectFootnotes": true,
    "DetectQuranVerses": true,
    "MinimumTextLength": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
